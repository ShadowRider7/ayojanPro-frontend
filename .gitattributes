# Normalize line endings: store LF in the repo and check out LF everywhere.
# This keeps Biome (which defaults to LF) happy on Windows checkouts that
# have core.autocrlf=true.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be normalized.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
